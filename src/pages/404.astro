---
import Base from '../layouts/Base.astro';
import Etiqueta from '../components/Etiqueta.astro';
---
<Base titulo="Página não encontrada, Mercearia Guimarães Rosa" descricao="Essa página não existe. Volte para o início ou veja o cardápio.">
  <section class="container nada">
    <Etiqueta tamanho={140} inclinacao={-10} carimbo><small>esgotou</small><b>404</b></Etiqueta>
    <h1>Essa página não está na prateleira</h1>
    <p>O endereço pode ter mudado. Volte para o início ou veja o cardápio.</p>
    <p><a class="link-seco" href="/">Ir para o início</a> ou <a class="link-seco" href="/cardapio">ver o cardápio</a></p>
  </section>
</Base>

<style>
  .nada { padding: 5rem 0 6rem; }
  .nada h1 { font-size: clamp(2.4rem, 8vw, 4rem); margin-top: 1.5rem; }
</style>
