---
import { Image } from 'astro:assets';
import type { Item } from '../data/cardapio';
import { foto } from '../data/fotos';
import { whats } from '../data/loja';

interface Props { item: Item; mostrarStatus?: boolean }
const { item, mostrarStatus = false } = Astro.props;
const pedido = whats(`Olá! Tem ${item.nome.toLowerCase()} hoje?`);
const busca = [item.nome, item.descricao ?? ''].join(' ').toLowerCase();
---
<li class:list={['item', { 'item--revisar': mostrarStatus && item.status === 'revisar' }]} data-busca={busca}>
  {item.foto && (
    <div class="item__foto">
      <Image src={foto(item.foto)} alt={item.nome} widths={[120, 240]} sizes="96px" loading="lazy" />
      {item.ilustrativa && <span class="item__ilustrativa">foto ilustrativa</span>}
    </div>
  )}
  <div class="item__texto">
    <h3 class="item__nome">
      {item.nome}
      {item.feitoAqui && <span class="item__feito marcador">feito aqui</span>}
    </h3>
    {item.descricao && <p class="item__descricao">{item.descricao}</p>}
    {mostrarStatus && item.status === 'revisar' && <p class="item__status">A revisar: a loja tem esse item?</p>}
    <a class="item__pedir" href={pedido} target="_blank" rel="noopener">Perguntar no WhatsApp</a>
  </div>
</li>

<style>
  .item {
    display: flex; gap: 1rem; align-items: flex-start;
    padding: 1rem 0; border-bottom: 1px solid var(--linha);
  }
  .item:last-child { border-bottom: 0; }
  .item[hidden] { display: none; }
  .item__foto { position: relative; flex: none; width: 96px; height: 96px; border-radius: 14px; overflow: hidden; background: var(--kraft); }
  .item__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .item__ilustrativa {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: rgb(23 35 27 / 0.72); color: #fff;
    font-size: 0.68rem; font-weight: 600; line-height: 1.2; text-align: center; padding: 0.2rem 0.2rem;
  }
  .item__texto { flex: 1; min-width: 0; }
  .item__nome {
    font-family: var(--fonte-texto); font-stretch: normal; letter-spacing: 0;
    font-size: 1.25rem; font-weight: 650; line-height: 1.3; margin: 0 0 0.2rem;
  }
  .item__feito { color: var(--lona-700); font-size: 1.2rem; margin-left: 0.4rem; white-space: nowrap; }
  .item__descricao { margin: 0 0 0.35rem; font-size: 1rem; color: var(--tinta-2); line-height: 1.5; }
  .item__status { margin: 0 0 0.35rem; font-size: 0.95rem; font-weight: 650; color: #7a5a00; }
  .item--revisar { background: var(--etiqueta-clara); padding-inline: 0.75rem; border-radius: 12px; border-bottom-color: transparent; margin-bottom: 0.4rem; }
  .item__pedir {
    display: inline-flex; align-items: center; min-height: 2.75rem;
    font-size: 1rem; font-weight: 650; color: var(--lona-700);
    text-decoration: underline; text-decoration-color: var(--etiqueta); text-decoration-thickness: 3px; text-underline-offset: 0.2em;
  }
</style>
